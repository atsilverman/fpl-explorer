# Copy to .env and fill in secrets:
#   cp .env.example .env
X_BEARER_TOKEN=

# The Odds API — EPL Markets page (python3 site/fetch_markets.py)
# https://the-odds-api.com/
ODDS_API_KEY=

# Optional — LLM annotation for Feed posts
# Claude (preferred if both are set). Default model is Haiku (cheaper labels).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Or OpenAI-compatible
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Fetch tuning (optional)
# POSTS_PER_ACCOUNT=10
# FORCE_USER_REFRESH=1
